# For local development, use your computer's local IP
# Find your IP: Windows (ipconfig), Mac/Linux (ifconfig)
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api/v1

# Production API (current)
EXPO_PUBLIC_API_URL=https://riversrwanda.com/api/v1
EXPO_PUBLIC_BASE_URL=https://riversrwanda.com

# Uncomment and update for local backend testing
# EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:3000/api/v1
# EXPO_PUBLIC_BASE_URL=http://YOUR_LOCAL_IP:3000
